######################################
# PIPELINE CONFIGURATION
######################################
IEEE_REF_TIMEOUT=12
IEEE_REF_SOURCE_TIMEOUT=8   # hard wall-clock cap per metadata-source query
IEEE_REF_CONCURRENCY=8
IEEE_REF_CACHE_TTL=3600
IEEE_REF_MAX_CORR=3
IEEE_REF_MAX_HOPS=12
IEEE_REF_STAGNATION=2
IEEE_REF_RECURSION_LIMIT=60
# (IEEE_REF_AGENT_THREADS removed — verification agents run inline now)

######################################
# LLM PROVIDER SELECTION
# auto | openai | azure | anthropic | ollama
######################################
IEEE_REF_LLM=auto

######################################
# OPENAI (direct)
######################################
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

######################################
# AZURE OPENAI
######################################
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_CHAT_DEPLOYMENT=       (chat deployment name; legacy aliases AZURE_OPENAI_DEPLOYMENT / AZURE_LLM_DEPLOYMENT also accepted)
# AZURE_EMBEDDING_DEPLOYMENT=  (embeddings deployment name; legacy alias AZURE_EMBEDDINGS_DEPLOYMENT also accepted)

######################################
# ANTHROPIC
######################################
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

######################################
# OLLAMA (local)
######################################
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

######################################
# METADATA SOURCES (optional)
######################################
# IEEE_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

######################################
# API ETIQUETTE / SERVER LIMITS
######################################
# Contact email sent in User-Agent to Crossref/NCBI (recommended)
# REFASSIST_CONTACT_EMAIL=you@yourdomain.com
# REFASSIST_MAX_PARALLEL_REFS=4
# REFASSIST_MAX_REFERENCES=200
# REFASSIST_SYNC_MAX_REFS=10               (bigger batches auto-queue as jobs, HTTP 202)
# REFASSIST_MAX_UPLOAD_BYTES=15728640      (per file)
# REFASSIST_MAX_FILES=10                   (per request)
# REFASSIST_MAX_TEXT_CHARS=2000000         (total extracted text per request)
# REFASSIST_MAX_ACTIVE_JOBS=3              (concurrent bulk jobs)
# REFASSIST_MAX_STORED_JOBS=100            (finished jobs kept for retrieval)
# REFASSIST_JOB_TTL=3600                   (seconds finished jobs remain downloadable)
# REFASSIST_REF_TIMEOUT=120                (wall-clock cap per reference, seconds)
# REFASSIST_RESULT_CACHE_TTL=3600          (re-checking unchanged references is instant)
# REFASSIST_RESULT_CACHE_SIZE=1000
# REFASSIST_RATE_LIMIT_MAX=30              (requests per window per client IP)
# REFASSIST_RATE_LIMIT_WINDOW=60           (window seconds)
# REFASSIST_MAX_PDF_PAGES=200              (pages read per PDF)
# REFASSIST_MAX_DOCX_UNCOMPRESSED=104857600  (zip-bomb guard, bytes)

######################################
# RAG / STYLE GUIDE
######################################
# IEEE_STYLE_GUIDE_PATH=   (defaults to the bundled Style_guide.pdf)
# IEEE_STYLE_PERSIST_DIR=.chroma_ieee_style

######################################
# RETRACTION WATCH DATASET
######################################
# REFASSIST_RW_PRELOAD=1          (download/refresh dataset at API startup)
# REFASSIST_RW_REFRESH_DAYS=7
# REFASSIST_RW_CACHE=.rw_cache/retraction_watch.csv
# REFASSIST_RW_DATASET_URL=       (defaults to Crossref's GitLab distribution)

######################################
# DEBUG / REPORTS
######################################
# IEEE_REF_LOG_LEVEL=INFO
# REFASSIST_WRITE_DOCX_REPORT=0
